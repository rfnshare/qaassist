{
  "name": "qa-assist",
  "private": true,
  "version": "0.0.0",
  "description": "Embedded QA assistant for feature/story QA workflows.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @qa-assist/api",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace @qa-assist/api",
    "build:extension": "npm run build --workspace @qa-assist/extension",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:api": "npm run typecheck --workspace @qa-assist/api",
    "typecheck:extension": "npm run typecheck --workspace @qa-assist/extension"
  }
}
